<% layout("/layouts/boilerplate2") -%>

<body>
    <div class="row mt-5" style="margin-bottom: 15rem;">
        <h1 class="col-6 offset-3 mb-4">SignUp on CampusCart</h1>
        <div class="col-6 offset-3">
            <form method="POST" action="/signup" novalidate class="needs-validation">
                <div class="mb-3">
                    <label form="username" class="form-label">Username</label>
                    <input 
                        name="username"
                        id="username" 
                        type="text" 
                        class="form-control" 
                        required
                    >
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                </div>
                
                <div class="mb-3">
                    <label form="email" class="form-label">Email</label>
                    <input name="email" id="email" type="email" class="form-control" required>
                </div>
                
                <div class="mb-3">
                    <label form="password" class="form-label">Password</label>
                    <input name="password" id="password" type="password" class="form-control" required>
                </div>

                <button class="btn btn-success mt-3">SignUp</button>
            </form>
        </div>
    </div>
</body>